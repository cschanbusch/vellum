{
  "id": "sidebar-test",
  "type": "skin",
  "name": "Sidebar test",
  "version": "1.0.0",
  "apiVersion": 1,
  "author": "Vellum tests",
  "description": "Rearranges the kit: a sidebar with views, search and filters; frameless window",
  "entry": "index.html",
  "skin": {
    "defaultView": "covers",
