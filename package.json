{
  "name": "vellum",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:shell": "npm run build:sdk && vite --config shell/vite.config.ts",
    "build:sdk": "tsc -p sdk && vite build --config sdk/vite.config.ts",
    "build:shell": "tsc -p shell && vite build --config shell/vite.config.ts",
    "build:web": "npm run build:sdk && npm run build:shell",
    "typecheck": "tsc -p sdk && tsc -p shell",
    "test": "vitest run",
    "tauri": "tauri",
    "mock-art": "cargo run --manifest-path src-tauri/Cargo.toml --release --example make_mock_art",
    "dev:skin": "node scripts/dev-skin.mjs",
    "test:e2e": "npm run build:sdk && playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
