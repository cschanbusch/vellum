{
  "id": "redline",
  "type": "skin",
  "name": "Grand Tourer",
  "version": "1.2.0",
  "apiVersion": 1,
  "author": "Vellum",
  "description": "Pearl, chrome and glossy blue: a racing-showroom menu in the style of early-2000s grand-touring games, with a Garage view, engine sounds and menu chimes.",
  "entry": "index.html",
  "skin": {
    "preview": "preview.jpg",
    "defaultView": "covers",
    "window": {
      "frameless": true,
      "minWidth": 1000,
      "minHeight": 640,
      "background": "#e8edf3"
    },
    "views": [
      {
        "id": "garage",
        "name": "Garage",
        "entry": "views/garage.js",
        "placement": {
          "after": "spotlight"
        },
        "couch": true
      }
    ],
    "options": [
      {
        "id": "signal",
        "label": "Signal color",
        "type": "color",
        "default": "#e0262b",
        "cssVar": "--rl-signal"
      },
      {
        "id": "motion",
        "label": "Motion (light sweeps, turntable, drift)",
        "type": "toggle",
        "default": true
      },
      {
        "id": "boot",
        "label": "Title screen on start",
        "type": "toggle",
        "default": true
      },
      {
        "id": "wear",
        "label": "Wear and tear (condition, stalls, service)",
        "type": "toggle",
        "default": true
      },
      {
        "id": "sounds",
        "label": "Engine sounds",
        "type": "toggle",
        "default": true
      },
      {
        "id": "menuSounds",
        "label": "Menu sounds (cursor ticks, chimes)",
        "type": "toggle",
        "default": true
      },
      {
        "id": "volume",
        "label": "Sound volume",
        "type": "range",
        "min": 0,
        "max": 100,
        "step": 5,
        "default": 70
      },
      {
        "id": "reflections",
        "label": "Floor reflection in the Garage",
        "type": "toggle",
        "default": true
      },
      {
        "id": "crt",
        "label": "480-line TV glow on the backdrop",
        "type": "toggle",
        "default": false
      },
      {
        "id": "coverSize",
        "label": "Cover size",
        "type": "range",
        "min": 140,
        "max": 300,
        "step": 10,
        "default": 180,
        "cssVar": "--v-cover-width",
        "unit": "px"
      }
    ]
  }
}
