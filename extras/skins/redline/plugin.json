{
  "id": "redline",
  "type": "skin",
  "name": "Grand Tour",
  "version": "1.5.0",
  "apiVersion": 1,
  "author": "Vellum",
  "description": "Pearl, chrome and glossy blue: a racing-showroom menu in the style of early-2000s grand-touring games, with a Garage view where every game gets a 3D case of its own, engine sounds and menu chimes.",
  "entry": "index.html",
  "skin": {
    "preview": "preview.jpg",
    "defaultView": "covers",
    "window": {
      "frameless": true,
      "minWidth": 1000,
      "minHeight": 640,
      "background": "#e8edf3"
    },
    "views": [
      {
        "id": "garage",
        "name": "Garage",
        "entry": "views/garage.js",
        "placement": {
          "after": "spotlight"
        },
        "couch": true
      }
    ],
    "options": [
      {
        "id": "signal",
        "label": "Signal color",
        "type": "color",
        "default": "#e0262b",
        "cssVar": "--rl-signal"
      },
      {
        "id": "motion",
        "label": "Motion (light sweeps, turntable, drift)",
        "type": "toggle",
        "default": true
      },
      {
        "id": "boot",
        "label": "Title screen on start",
        "type": "toggle",
        "default": true
      },
      {
        "id": "wear",
        "label": "Wear and tear (condition, stalls, service)",
        "type": "toggle",
        "default": true
      },
      {
        "id": "tuneUp",
        "label": "Tune-up timing",
        "type": "select",
        "default": "standard",
        "choices": [
          {
            "value": "relaxed",
            "label": "Relaxed"
          },
          {
            "value": "standard",
            "label": "Standard"
          },
          {
            "value": "tricky",
            "label": "Tricky"
          }
        ]
      },
      {
        "id": "sounds",
        "label": "Engine sounds",
        "type": "toggle",
        "default": true
      },
      {
        "id": "menuSounds",
        "label": "Menu sounds (cursor ticks, chimes)",
        "type": "toggle",
        "default": true
      },
      {
        "id": "volume",
        "label": "Sound volume",
        "type": "range",
        "min": 0,
        "max": 100,
        "step": 5,
        "default": 70
      },
      {
        "id": "reflections",
        "label": "Floor reflection in the Garage",
        "type": "toggle",
        "default": true
      },
      {
        "id": "caseSteam",
        "label": "Steam games' cases",
        "type": "select",
        "default": "keepcase-dvd",
        "choices": [
          {
            "value": "keepcase-dvd",
            "label": "DVD keep case"
          },
          {
            "value": "keepcase-bd",
            "label": "Blu-ray keep case"
          },
          {
            "value": "bigbox",
            "label": "PC big box"
          }
        ]
      },
      {
        "id": "caseEpic",
        "label": "Epic games' cases",
        "type": "select",
        "default": "keepcase-dvd",
        "choices": [
          {
            "value": "keepcase-dvd",
            "label": "DVD keep case"
          },
          {
            "value": "keepcase-bd",
            "label": "Blu-ray keep case"
          },
          {
            "value": "bigbox",
            "label": "PC big box"
          }
        ]
      },
      {
        "id": "caseGog",
        "label": "GOG games' cases",
        "type": "select",
        "default": "bigbox",
        "choices": [
          {
            "value": "keepcase-dvd",
            "label": "DVD keep case"
          },
          {
            "value": "keepcase-bd",
            "label": "Blu-ray keep case"
          },
          {
            "value": "bigbox",
            "label": "PC big box"
          }
        ]
      },
      {
        "id": "caseXbox",
        "label": "Xbox games' cases",
        "type": "select",
        "default": "keepcase-bd",
        "choices": [
          {
            "value": "keepcase-dvd",
            "label": "DVD keep case"
          },
          {
            "value": "keepcase-bd",
            "label": "Blu-ray keep case"
          },
          {
            "value": "bigbox",
            "label": "PC big box"
          }
        ]
      },
      {
        "id": "casePcsx2",
        "label": "PCSX2 games' cases",
        "type": "select",
        "default": "keepcase-dvd",
        "choices": [
          {
            "value": "keepcase-dvd",
            "label": "DVD keep case"
          },
          {
            "value": "keepcase-bd",
            "label": "Blu-ray keep case"
          },
          {
            "value": "bigbox",
            "label": "PC big box"
          }
        ]
      },
      {
        "id": "caseOther",
        "label": "Other games' cases",
        "type": "select",
        "default": "keepcase-dvd",
        "choices": [
          {
            "value": "keepcase-dvd",
            "label": "DVD keep case"
          },
          {
            "value": "keepcase-bd",
            "label": "Blu-ray keep case"
          },
          {
            "value": "bigbox",
            "label": "PC big box"
          }
        ]
      },
      {
        "id": "richBacks",
        "label": "Rich case backs (blurred hero art)",
        "type": "toggle",
        "default": false
      },
      {
        "id": "crt",
        "label": "480-line TV glow on the backdrop",
        "type": "toggle",
        "default": false
      },
      {
        "id": "coverSize",
        "label": "Cover size",
        "type": "range",
        "min": 140,
        "max": 300,
        "step": 10,
        "default": 180,
        "cssVar": "--v-cover-width",
        "unit": "px"
      }
    ]
  }
}
